SARVAM_API_KEY=
ANTHROPIC_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=bharatbot

# Azure AI Foundry - primary LLM + embeddings
# Use the unified v1 endpoint from your Foundry project (ends in /openai/v1)
# The deployment names below must match EXACTLY what you named them on your
# Foundry project's Deployments page - they don't have to match the model name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/openai/v1
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Postgres + pgvector - vector store for document chunks
# Matches the `postgres` service in Docker-compose.yaml; if you're running
# Postgres yourself instead, point this at your own instance.
DATABASE_URL=postgresql://bharatbot:bharatbot@localhost:5432/bharatbot

# Ports (used by Docker-compose.yaml service mappings)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Optional overrides - defaults shown below, uncomment to change
# API_URL=http://localhost:8000
# SARVAM_MODEL=sarvam-30b
# CLAUDE_MODEL=claude-sonnet-4-20250514
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K_RESULTS=8
# EMBEDDING_DIM=1536
